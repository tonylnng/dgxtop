# Copy to .env and fill in. .env is gitignored.
#
# Tailscale IP of this DGX host. Get it with: `tailscale ip -4 | head -1`
# The WebUI listens ONLY on this address — never on 0.0.0.0.
TAILSCALE_IP=100.x.y.z

# HTTP Basic Auth (Nginx). Rotate anytime with:
#   $ vim .env  &&  docker compose up -d --force-recreate webui
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-please

# TimescaleDB password (used by both `db` and `exporter`).
POSTGRES_PASSWORD=change-me-too
